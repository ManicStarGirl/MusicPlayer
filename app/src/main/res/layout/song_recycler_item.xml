<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <ImageView
        android:id="@+id/song_cover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/ic_playlist"
        android:background="?attr/onBackground"
        app:tint="?attr/appBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/song_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Song Title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/appButton"
        app:layout_constraintBottom_toTopOf="@id/song_artist"
        app:layout_constraintEnd_toStartOf="@+id/song_duration"
        app:layout_constraintStart_toEndOf="@id/song_cover"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/song_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Artist Name"
        android:textColor="?attr/appButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/song_duration"
        app:layout_constraintStart_toStartOf="@id/song_title"
        app:layout_constraintTop_toBottomOf="@id/song_title" />

    <TextView
        android:id="@+id/song_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3:20"
        android:textColor="?attr/appButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>