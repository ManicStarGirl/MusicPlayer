<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/library_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music Library"
            android:textSize="30sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="?attr/appButton"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:id="@+id/second_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="10dp"
            app:layout_constraintTop_toBottomOf="@id/library_title"
            android:gravity="center">

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <Button
                android:id="@+id/btn_songs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Songs"
                android:backgroundTint="?attr/onBackground"
                android:textColor="?attr/appButton" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <Button
                android:id="@+id/btn_albums"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Albums"
                android:textColor="?attr/appButton"
                android:backgroundTint="?attr/onBackground" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <Button
                android:id="@+id/btn_artists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artists"
                android:textColor="?attr/appButton"
                android:backgroundTint="?attr/onBackground" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <!-- IMPORTANT: The container must have wrap_content height to scroll -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/library_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/second_bar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>