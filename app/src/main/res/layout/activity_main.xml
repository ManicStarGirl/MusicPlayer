<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity"
    android:background="?attr/windowInsets">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        android:background="?attr/onBackground">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/btn_full_screen_player"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_empty_music"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/appButton"
            android:contentDescription="Full Screen Player"
            />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/btn_music_library"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_music_library"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/appButton"
            android:contentDescription="Music Library"
            />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/btn_playlists"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_playlist"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/appButton"
            android:contentDescription="Playlists"
            />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"/>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:background="?attr/onBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/current_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01:04"
                android:textStyle="bold"
                android:textColor="?attr/appButton"/>


            <SeekBar
                android:id="@+id/music_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progress="30"
                android:max="100"
                android:progressTint="?attr/appButton"
                android:thumbTint="?attr/appButton" />


            <TextView
                android:id="@+id/song_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:35"
                android:textStyle="bold"
                android:textColor="?attr/appButton"
                app:layout_constraintTop_toTopOf="parent"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center">


            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:src="@drawable/ic_shuffle_off"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/appButton"
                android:contentDescription="Shuffle" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/btn_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_skip_previous"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/appButton"
                android:contentDescription="Skip Previous"/>
            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_play_arrow"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/appButton"
                android:contentDescription="Play"/>
            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_skip_next"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/appButton"
                android:contentDescription="Skip Next"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:src="@drawable/ic_repeat_on"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/appButton"
                android:contentDescription="Repeat" />
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>